{
  "name": "@elek-io/desktop",
  "productName": "elek.io Desktop",
  "desktopName": "io.elek.desktop.desktop",
  "description": "The elek.io Desktop is a desktop application for Windows, macOS and Linux that allows you to manage content.",
  "version": "0.4.0",
  "type": "module",
  "main": "./out/main/index.js",
  "homepage": "https://elek.io",
  "repository": "https://github.com/elek-io/desktop",
  "bugs": {
    "url": "https://github.com/elek-io/desktop/issues"
  },
  "author": {
    "name": "elek.io",
    "email": "info@elek.io",
    "url": "https://elek.io"
  },
  "license": "todo",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "clean": "rimraf ./out && rimraf ./dist",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "lint": "eslint",
    "check-types:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "check-types:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "check-types": "pnpm run check-types:node && pnpm run check-types:web",
    "check": "pnpm run lint && pnpm run check-types && pnpm run check-format",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run clean && electron-vite build && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build --dir",
    "build:win": "pnpm run build --win",
    "build:mac": "pnpm run build --mac",
    "build:linux": "pnpm run build --linux",
    "test": "pnpm run build:unpack && playwright test",
    "test:debug": "pnpm run build:unpack && playwright test --debug",
    "test:ui": "pnpm run build:unpack && playwright test --ui",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@elek-io/core": "0.26.0",
    "dugite": "3.3.2",
    "electron-updater": "6.8.11",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@changesets/cli": "3.0.3",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@electron-toolkit/eslint-config-prettier": "3.0.1",
    "@electron-toolkit/eslint-config-ts": "4.0.0",
    "@electron-toolkit/preload": "3.0.2",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@hookform/devtools": "4.4.0",
    "@hookform/resolvers": "6.0.1",
    "@milkdown/kit": "7.23.0",
    "@milkdown/react": "7.23.0",
    "@playwright/test": "1.63.0",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-query-devtools": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/router-plugin": "1.168.48",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@tsconfig/vite-react": "8.1.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-playwright-helpers": "3.1.2",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "lucide-react": "1.62.0",
    "next-themes": "0.4.6",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "rimraf": "6.1.3",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
